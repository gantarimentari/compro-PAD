// jsconfig.json (Pastikan ini yang digunakan)
{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"], // Alias untuk folder src
      "@ds/*": ["components/*"], // Alias untuk folder komponen di root utama
      "@lib/*": ["lib/*"], // Alias untuk folder lib
      "@/lib/*": ["src/lib/*"], // Alias agar @/lib/* resolve ke src/lib/*
      "@layout/*": ["layout/*"] // Alias untuk folder layout
    }
  }
}